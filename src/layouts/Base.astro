---
// Fonts are self-hosted (no requests to Google), latin subsets only.
import "@fontsource/arvo/latin-400.css";
import "@fontsource/arvo/latin-700.css";
import "@fontsource/lilita-one/latin-400.css";
import "../styles/global.css";
import { site } from "../site.js";
import { released, inProduction } from "../data/gamemodes.js";

const { title, description = `${site.name} is a community rehost of GMod Tower for Garry's Mod: condos, stores, events and classic gamemodes.` } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ticker = site.ticker.join("  ***  ");
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));

const featured = [...released, ...inProduction]
	.filter((gm) => gm.logo)
	.map((gm) => ({ id: gm.id, name: gm.name, logo: gm.logo, players: gm.players }));
const server = site.servers[0];
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="color-scheme" content="dark" />
	<title>{site.name} :: {title}</title>
	<meta name="description" content={description} />
	<meta property="og:site_name" content={site.name} />
	<meta property="og:title" content={`${site.name} :: ${title}`} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={new URL("/img/gmt/shots/condo1.jpg", Astro.site)} />
	<meta property="og:url" content={canonical} />
	<meta name="theme-color" content="#222222" />
	{!site.indexable && <meta name="robots" content="noindex, nofollow" />}
	<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
	<div id="page"><span id="top"></span>
		<header id="masthead">
			<a href="/" class="masthead-link">
				<img src="/logo-icon.svg" width="72" height="72" alt="" class="masthead-icon" />
				<span class="masthead-text">
					<span class="site-title">{site.name}</span>
					<span class="site-tagline">{site.tagline}</span>
				</span>
			</a>
		</header>

		<nav id="menu">
			<ul>
				{site.nav.map((item) => (
					<li><a href={item.href} class={!item.external && isActive(item.href) ? "active" : undefined}>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<div id="ticker" aria-label="News ticker">
			<div class="ticker-track">
				<span>***  {ticker}  ***</span>
				<span aria-hidden="true">***  {ticker}  ***</span>
			</div>
		</div>

		<div id="columns">
			<main id="main">
				<slot />
			</main>

			<aside id="sidebar">
				<div class="side-box">
					<h3 class="side-title">:: Server Status ::</h3>
					<div class="side-body">
						<dl class="status">
							<dt>Status:</dt><dd class="status-flag" id="live-status">[{site.status.label}]</dd>
							<dt>Players:</dt><dd id="live-players">[{site.status.players}]</dd>
							<dt>Map:</dt><dd id="live-map">[{site.status.map}]</dd>
						</dl>
						<div class="ip-box">{server.address}</div>
						<a class="btn btn-gold" href={`steam://connect/${server.address}`}>Connect Now!</a>
						<p class="side-note">Subscribe to the <a href={site.links.workshop}>Workshop collection</a> first!</p>
					</div>
				</div>

				<div class="side-box">
					<h3 class="side-title">:: Navigation ::</h3>
					<div class="side-body">
						<ul class="side-links">
							{site.sidebarLinks.map((l) => <li><a href={l.href}>&raquo; {l.label}</a></li>)}
						</ul>
					</div>
				</div>

				<div class="side-box">
					<h3 class="side-title">:: Featured Game ::</h3>
					<div class="side-body center" id="featured">
						<a href={`/gamemodes#${featured[0].id}`} class="featured-link">
							<img src={featured[0].logo} alt={featured[0].name} class="featured-logo" />
						</a>
						<div class="featured-players">{featured[0].players}</div>
						<a href={`/gamemodes#${featured[0].id}`} class="featured-more">Learn more &raquo;</a>
					</div>
				</div>

				{site.links.discord && (
					<div class="side-box">
						<h3 class="side-title">:: Community ::</h3>
						<div class="side-body center">
							<p class="side-note">Chat, report bugs and hear about events first.</p>
							<a class="btn btn-discord" href={site.links.discord}>Join our Discord</a>
						</div>
					</div>
				)}

				<div class="side-box counter-box">
					<div class="side-body center">
						<div>You are visitor #</div>
						<div class="counter" id="live-counter">
							{"000000".split("").map((d) => <span>{d}</span>)}
						</div>
					</div>
				</div>
			</aside>
		</div>

		<footer id="footer">
			<div class="badges">
				<a href="/" class="badge badge-site"><img src="/logo-icon.svg" alt="" width="22" height="22" />Skyline<br />Tower</a>
				<a href="https://gmod.facepunch.com/" class="badge badge-gmod">Powered by<br />Garry's Mod</a>
				<span class="badge badge-source">Source&trade;<br />Engine</span>
				{site.links.discord && <a href={site.links.discord} class="badge badge-discord">Join us on<br />Discord</a>}
			</div>
			<p>Best viewed in 1024x768 with any browser</p>
			<p>&copy; 2026 {site.name}. Not affiliated with PixelTail Games, Facepunch Studios or Valve.<br />
			GMod Tower artwork &copy; PixelTail Games. Carrying on the legacy of <a href="https://www.pixeltailgames.com/">GMod Tower</a>.</p>
		</footer>
	</div>

	<script is:inline>
		// Live server status and visitor counter, refreshed every minute on the VPS.
		(function () {
			function mapName(map) {
				if (/^gmt_lobby2/.test(map)) return "Lobby 2";
				if (/^gmt_build0|^gmt_lobby_/.test(map)) return "Lobby";
				return map.replace(/^gmt_/, "");
			}
			function set(id, text, cls) {
				var el = document.getElementById(id);
				if (!el) return;
				el.textContent = "[" + text + "]";
				if (cls !== undefined) el.className = "status-flag " + cls;
			}
			function unknown() {
				set("live-status", "UNKNOWN", "is-unknown");
				set("live-players", "-- / --");
				set("live-map", "--");
			}
			function show(live) {
				var s = live.server || {};
				// The VPS rewrites live.json every minute; much older means the updater stopped.
				var fresh = !live.updated || Date.now() / 1000 - live.updated < 600;
				if (!fresh) {
					unknown();
				} else if (s.online) {
					set("live-status", "ONLINE", "is-online");
					set("live-players", s.players + " / " + s.maxPlayers);
					set("live-map", mapName(s.map || ""));
				} else {
					set("live-status", "OFFLINE", "is-offline");
					set("live-players", "-- / --");
					set("live-map", "--");
				}
				var digits = String(Math.max(0, live.visitors | 0));
				while (digits.length < 6) digits = "0" + digits;
				var counter = document.getElementById("live-counter");
				if (counter) {
					counter.innerHTML = "";
					digits.split("").forEach(function (d) {
						var span = document.createElement("span");
						span.textContent = d;
						counter.appendChild(span);
					});
				}
			}
			// Remember the last status so every page draws it straight away instead of flashing
			// the placeholders; live.json only changes once a minute, so reuse it for that long.
			var KEY = "skyline-live", MAX_AGE = 60000;
			function load() {
				try { return JSON.parse(localStorage.getItem(KEY)); } catch (e) { return null; }
			}
			function save(live) {
				try { localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), live: live })); } catch (e) {}
			}
			var busy = false;
			function refresh() {
				if (busy || document.hidden) return;
				var cached = load();
				if (cached && Date.now() - cached.at < MAX_AGE) return;
				busy = true;
				var ctrl = window.AbortController ? new AbortController() : null;
				var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 8000);
				fetch("/live/live.json", { cache: "no-store", signal: ctrl ? ctrl.signal : undefined })
					.then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
					.then(function (live) { save(live); show(live); })
					.catch(unknown)
					.then(function () { clearTimeout(timer); busy = false; });
			}
			var cached = load();
			if (cached && cached.live) show(cached.live);
			refresh();
			// Keep it current while the page stays open, but don't poll from background tabs.
			setInterval(refresh, 15000);
			document.addEventListener("visibilitychange", refresh);
		})();
	</script>

	<script is:inline define:vars={{ featured }}>
		// Rotate the Featured Game box on each page load.
		var pick = featured[Math.floor(Math.random() * featured.length)];
		var box = document.getElementById("featured");
		box.querySelectorAll("a").forEach(function (a) { a.href = "/gamemodes#" + pick.id; });
		var img = box.querySelector("img");
		img.src = pick.logo;
		img.alt = pick.name;
		box.querySelector(".featured-players").textContent = pick.players;
	</script>
</body>
</html>
