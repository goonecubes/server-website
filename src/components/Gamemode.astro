---
const { gm } = Astro.props;
const mapLabel = gm.maps.length === 1 ? "1 map" : `${gm.maps.length} maps`;
---
<div class="gm" id={gm.id}>
	<a class="gm-link" href={`/gamemodes/${gm.id}/`}>
		{gm.banner ? (
			<img class="gm-banner" src={gm.banner} alt={gm.name} loading="lazy" />
		) : (
			<div class={`gm-banner gm-banner-${gm.id}`} role="img" aria-label={gm.name}>{gm.name}</div>
		)}
	</a>
	<p class="gm-line"><b>{gm.players}</b> &middot; {mapLabel} &middot; <a href={`/gamemodes/${gm.id}/`}>View more info &raquo;</a></p>
</div>
