---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import Gamemode from "../components/Gamemode.astro";
import { released, inProduction } from "../data/gamemodes.js";
---
<Base title="Gamemodes" description="Every gamemode on Skyline Tower: Ball Race, Virus, PVP Battle, Ultimate Chimera Hunt, Zombie Massacre, Minigolf and more.">
	<h1 class="page-heading">Gamemodes</h1>

	<Panel title="Released">
		<p class="note">&#9654; Every gamemode that's live and ready to play. Click a banner to read more and see its maps.</p>
		<div class="gm-list">
			{released.map((gm) => <Gamemode gm={gm} />)}
		</div>
	</Panel>

	<Panel title="In Production">
		<p class="note">&#9654; Gamemodes we're still restoring and polishing. They may show up for testing before their full release.</p>
		<div class="gm-list">
			{inProduction.map((gm) => <Gamemode gm={gm} />)}
		</div>
	</Panel>

	<script is:inline>
		// Open the gamemode named in the URL (e.g. from the Featured Game box), including
		// when that link is clicked while already on this page.
		function openFromHash() {
			var target = location.hash && document.querySelector("details" + location.hash);
			if (target) target.open = true;
		}
		openFromHash();
		window.addEventListener("hashchange", openFromHash);
	</script>
</Base>
