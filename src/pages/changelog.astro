---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import changelog from "../../public/changelog.json";

// Same file the in-game Transit Station wall reads: numbered keys, each [title, ...items].
const entries = Object.keys(changelog)
	.filter((k) => /^\d+$/.test(k))
	.sort((a, b) => Number(a) - Number(b))
	.map((k) => ({ title: changelog[k][0], items: changelog[k].slice(1) }));
---
<Base title="Changelog" description="What's new on Skyline Tower.">
	<h1 class="page-heading">Changelog</h1>
	<div class="callout"><b>Latest update:</b> {changelog.date} &middot; This is the same changelog shown on the big screen in the Transit Station.</div>

	{entries.map((e) => (
		<Panel title={e.title}>
			<div class="changelog-entry">
				<ul>{e.items.map((i) => <li>{i}</li>)}</ul>
			</div>
		</Panel>
	))}
</Base>
