---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import { site } from "../site.js";

// TODO: replace with the real team.
const staff = [
	{ rank: "Owner", members: ["Your Name Here"] },
	{ rank: "Developers", members: ["TBA"] },
	{ rank: "Admins", members: ["TBA"] },
	{ rank: "Moderators", members: ["TBA"] },
];
---
<Base title="Staff">
	<h1 class="page-heading">Staff Team</h1>
	<Panel title="Who keeps the tower running">
		<p>If you need help in-game, look for the staff tag in chat or ask on <a href={site.links.discord}>Discord</a>.</p>
		<table class="list">
			<thead><tr><th style="width:35%">Rank</th><th>Members</th></tr></thead>
			<tbody>
				{staff.map((s) => <tr><td><b>{s.rank}</b></td><td>{s.members.join(", ")}</td></tr>)}
			</tbody>
		</table>
	</Panel>
</Base>
