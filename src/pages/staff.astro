---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import { site } from "../site.js";

// Fill in the team, e.g. { rank: "Owner", members: ["Name"] }. While empty, the page says the list is coming.
const staff = [];
---
<Base title="Staff">
	<h1 class="page-heading">Staff Team</h1>
	<Panel title="Who keeps the tower running">
		<p>If you need help in-game, look for the staff tag in chat{site.links.discord && <> or ask on <a href={site.links.discord}>Discord</a></>}.</p>
		{staff.length ? (
			<table class="list">
				<thead><tr><th style="width:35%">Rank</th><th>Members</th></tr></thead>
				<tbody>
					{staff.map((s) => <tr><td><b>{s.rank}</b></td><td>{s.members.join(", ")}</td></tr>)}
				</tbody>
			</table>
		) : (
			<p class="note">&#9654; The staff list will be posted before the public launch.</p>
		)}
	</Panel>
</Base>
