---
import Base from "../layouts/Base.astro";
---
<Base title="Profile">
	<div class="post">
		<h2 class="section-title">Skyline Profile</h2>
		<div class="box center">
			<p>Your Skyline profile will show all your gameplay stats online for everyone to see: GMC, level, achievements, high scores and more.</p>
			<p><a class="btn btn-blue" href="#" aria-disabled="true" style="opacity:.6;pointer-events:none">Sign in through Steam</a></p>
			<p><i>Coming soon, once the servers are live.</i></p>
		</div>
	</div>
</Base>
