---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";

// Leaderboards will be filled from the game database (read-only) once the stats API exists.
const boards = [
	{ title: "Richest Players", col: "GMC" },
	{ title: "Blockles High Scores", col: "Score" },
	{ title: "Most Achievements", col: "Achievements" },
];
---
<Base title="Stats" description="Skyline Tower leaderboards: richest players, Blockles high scores and most achievements.">
	<h1 class="page-heading">Tower Stats</h1>
	<p class="note">&#9654; Leaderboards go live when the servers open to the public.</p>
	{boards.map((b) => (
		<Panel title={b.title}>
			<table class="list">
				<thead><tr><th class="rank">#</th><th>Player</th><th class="num">{b.col}</th></tr></thead>
				<tbody>
					<tr><td class="rank">-</td><td class="empty-row">No entries yet.</td><td class="num">-</td></tr>
				</tbody>
			</table>
		</Panel>
	))}
</Base>
